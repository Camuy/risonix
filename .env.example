# Risonix — configurazione ambiente (esempio)
# Copiare in `.env` (`cp .env.example .env`) e adattare. NON committare `.env`.
# Nessun valore reale o segreto qui dentro.
# Riferimento completo: docs/CONFIGURATION.md (issue P0-10).

# ---- Profili Compose (default, ai, dicom, full, prod) ----------------------
# Profilo attivo quando `docker compose up` è eseguito senza `--profile`.
# Nota: passando `--profile` da CLI questo valore viene ignorato (non unione):
# per profili additivi usare più `--profile`.
COMPOSE_PROFILES=default

# ---- Generali --------------------------------------------------------------
# Ambiente logico: development | staging | production.
MRI_ENV=development
# Livello di logging: critical | error | warning | info | debug.
MRI_LOG_LEVEL=info
# Formato del log: json (strutturato) | text.
MRI_LOG_FORMAT=json
# Indirizzo di bind dei servizi: solo localhost per default (ARCHITECTURE D8).
# NON impostare 0.0.0.0: esporrebbe i servizi sulla rete locale.
MRI_BIND_ADDR=127.0.0.1

# ---- Porte (host) ----------------------------------------------------------
MRI_FRONTEND_PORT=5173
MRI_FRONTEND_PROD_PORT=3000
MRI_API_PORT=8000
MRI_AI_PORT=8001
MRI_ORTHANC_HTTP_PORT=8042
MRI_ORTHANC_DICOM_PORT=4242
MRI_PROXY_PORT=80

# URL dell'API visto dal browser (frontend dev). Deve puntare a localhost.
MRI_API_PUBLIC_URL=http://localhost:8000

# Origin ammessi dalla CORS dell'API (in prod il frontend è same-origin via Nginx
# e la lista può restare vuota). Default se omesso:
# ["http://localhost:5173","http://127.0.0.1:5173"]
# MRI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Segreti (profilo dicom) -----------------------------------------------
# ATTENZIONE: valori di esempio. Cambiarli in `.env` (mai committato) e usare
# credenziali non banali fuori dall'ambiente locale. Mai loggare questi valori.
MRI_ORTHANC_USER=orthanc
MRI_ORTHANC_PASSWORD=orthanc
